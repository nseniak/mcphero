# Frontend env vars (read by Vite at build/dev time).
# Copy to `frontend/.env.local` to use locally. `.env.local` is gitignored.

# Public site URL — drives canonical, og:url, og:image, twitter:image,
# JSON-LD URLs, sitemap.xml, and robots.txt. No trailing slash.
VITE_SITE_URL=https://mcphero.io

# Gateway origin shown in the SignupPage URL preview. Leave empty for
# single-origin deploys (preview falls back to window.location.origin).
# Set to the gateway subdomain (e.g. https://mcp.mcphero.io) so the URL
# the user sees during signup matches the one they'll paste into Claude.
# In Docker prod the equivalent is MCPOLIS_FRONTEND_GATEWAY_URL, which
# docker-compose maps to this VITE_ build arg.
VITE_GATEWAY_URL=
# Marketing contact addresses surfaced on the Privacy / Terms / Security / Support pages.
VITE_CONTACT_EMAIL=hello@mcphero.io
VITE_PRIVACY_EMAIL=privacy@mcphero.io
VITE_SECURITY_EMAIL=security@mcphero.io
VITE_SUPPORT_EMAIL=support@mcphero.io

# Sentry (optional — empty DSN disables Sentry entirely).
# Create a JavaScript/React project at sentry.io and paste its DSN here.
VITE_SENTRY_DSN=
# 0.0 disables tracing; 1.0 traces every navigation. 0.1 is a safe default.
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# Usually a git SHA, injected at deploy time. Leave empty locally.
VITE_RELEASE=

# Mixpanel (optional — empty token disables product analytics entirely).
# Project tokens are write-only, so it's safe to ship in the bundle.
VITE_MIXPANEL_TOKEN=
# Set to ``https://api-eu.mixpanel.com`` for EU data residency. Empty = US default.
VITE_MIXPANEL_API_HOST=
