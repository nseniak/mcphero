# MCPolis Configuration

# Dashboard OAuth provider:
#   "google"   — Google sign-in. Production. Requires
#                MCPOLIS_GOOGLE_CLIENT_ID / MCPOLIS_GOOGLE_CLIENT_SECRET.
#   "dev_stub" — In-app email picker that issues a real signed cookie
#                (default in standalone mode). Refused at startup in
#                cloud mode.
# Defaults to dev_stub in standalone, google in cloud.
MCPOLIS_OAUTH_PROVIDER=dev_stub
MCPOLIS_GOOGLE_CLIENT_ID=
MCPOLIS_GOOGLE_CLIENT_SECRET=
MCPOLIS_SERVER_URL=http://localhost:8080

# Public URL where the gateway MCP is exposed. Leave empty for
# single-origin deploys (gateway and dashboard share MCPOLIS_SERVER_URL).
# Set to a subdomain (e.g. https://mcp.mcphero.io) when running the
# gateway on its own host while the dashboard stays on apex.
MCPOLIS_GATEWAY_URL=

# Server. Default 8080 matches the code default in
# entrypoints/config.py and the hardcoded references in start.sh /
# stop.sh.
MCPOLIS_HOST=127.0.0.1
MCPOLIS_PORT=8080

# Sentry (optional — empty DSN disables Sentry entirely)
# Create a Python project at sentry.io and paste its DSN here.
MCPOLIS_SENTRY_DSN=
# Defaults to MCPOLIS_MODE when empty (e.g. "standalone" / "cloud").
MCPOLIS_SENTRY_ENVIRONMENT=
# 0.0 disables tracing; 1.0 traces every request. 0.1 is a safe default.
MCPOLIS_SENTRY_TRACES_SAMPLE_RATE=0.1
# Usually a git SHA, injected at deploy time. Leave empty locally.
MCPOLIS_RELEASE=

# Mixpanel (optional — empty token disables product analytics entirely).
# Use the project token from your Mixpanel project settings.
MCPOLIS_MIXPANEL_TOKEN=
# Set to ``api-eu.mixpanel.com`` for EU data residency. Empty = US default.
MCPOLIS_MIXPANEL_API_HOST=

# Sandbox provider for stdio MCPs. One of:
#   - e2b              hosted SaaS (requires MCPOLIS_E2B_API_KEY)
#   - local-subprocess no isolation; dev only (rejected in cloud mode)
# Empty falls back to e2b when MCPOLIS_E2B_API_KEY is set, else
# local-subprocess with a startup warning. See the "Sandbox provider
# selection" section in CLAUDE.md.
# MCPOLIS_SANDBOX_PROVIDER=
# MCPOLIS_E2B_API_KEY=
