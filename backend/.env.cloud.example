# ════════════════════════════════════════════════════════════════════
#   LOCAL DEVELOPMENT DEFAULTS — CLOUD MODE
#
#   This file is copied to ``backend/.env.cloud`` by ``bash start.sh
#   cloud`` on a developer's machine. It is NOT a production template.
#   Do NOT copy it into a production deployment — use
#   ``.env.cloud.docker.example`` at the repo root for that.
# ════════════════════════════════════════════════════════════════════
#
# Copy this file to ``backend/.env.cloud`` on first run and edit as
# needed. The real file is gitignored so you can keep the secrets
# local. Rotating a secret here is safe — it only affects your dev
# install. The persistent ``mcpolis_dev`` database uses the
# encryption key below, so changing the key means any tokens
# previously written to that DB will no longer decrypt (wipe the
# database with ``docker compose --profile dev down -v`` to start
# clean if that happens).

MCPOLIS_MODE=cloud
MCPOLIS_SESSION_SECRET=dev-cloud-session-secret-change-me-0123456789
MCPOLIS_ENCRYPTION_KEY=dev-cloud-encryption-key-change-me-0123456789
MCPOLIS_MONGO_URI=mongodb://localhost:27017
MCPOLIS_MONGO_DB_NAME=mcpolis_dev
MCPOLIS_REDIS_URL=redis://localhost:6379

# Public URL where the gateway MCP is exposed. Leave empty for
# single-origin deploys (gateway and dashboard share MCPOLIS_SERVER_URL).
# Set to a subdomain (e.g. https://mcp.mcphero.io) when running the
# gateway on its own host.
MCPOLIS_GATEWAY_URL=

# Stdio MCPs default to OFF in cloud mode. Uncomment to re-enable for
# local cloud-dev smoke-testing of stdio handling.
# MCPOLIS_ALLOW_STDIO_MCP=true

# Bundled "kitchen sink" demo MCP server. Two independent toggles —
# ``bash start.sh`` flips both for local dev so the dashboard ships
# with a working demo upstream; uncomment here only if you want them
# on without going through start.sh.
#   - MCPOLIS_DEMO_MOUNT=1 mounts the demo at /dev/mcp-demo.
#   - MCPOLIS_DEMO_SEED=1 auto-registers it as a service-account
#     upstream on the default (standalone) or first (cloud) org.
# MCPOLIS_DEMO_MOUNT=1
# MCPOLIS_DEMO_SEED=1

# Sandbox provider selection. ``e2b`` requires MCPOLIS_E2B_API_KEY;
# ``local-subprocess`` runs with no isolation (dev only). Empty falls
# back to e2b when a key is set, else local-subprocess with a startup
# warning (dev convenience — local-subprocess is rejected in
# production cloud mode). See the "Sandbox provider selection"
# section in CLAUDE.md.
# MCPOLIS_SANDBOX_PROVIDER=
# MCPOLIS_E2B_API_KEY=

# Idle window before E2B auto-pauses a sandbox, in seconds. Default
# 60s. Wake-from-paused was empirically measured at 361–759 ms in
# the integration suite (your log backend shows the live p99 via
# the ``reattach_duration_ms`` field on ``sandbox.e2b.reattach.ok``
# log events). Paused sandboxes are free (E2B docs: "Once a sandbox
# is paused, killed or times out, billing stops immediately"), so
# tighter = cheaper. Don't go below ~60s — sandboxes risk pausing
# mid-operation.
# MCPOLIS_E2B_IDLE_PAUSE_SECONDS=60

# Sentry (optional — empty DSN disables Sentry entirely).
MCPOLIS_SENTRY_DSN=
MCPOLIS_SENTRY_ENVIRONMENT=development
MCPOLIS_SENTRY_TRACES_SAMPLE_RATE=0.1
MCPOLIS_RELEASE=

# Mixpanel (optional — empty token disables product analytics entirely).
MCPOLIS_MIXPANEL_TOKEN=
# Set to ``api-eu.mixpanel.com`` for EU data residency. Empty = US default.
MCPOLIS_MIXPANEL_API_HOST=

# Transactional email (SMTP) for the §5.2 re-auth notifier. Empty
# host (the dev default) keeps the logging StubEmailSender, so nothing
# leaves the process — emails show up in the backend log as
# ``email.stub.sent``. To test real delivery locally, point these at a
# Workspace App Password (see .env.cloud.docker.example for the full
# Google Workspace setup) and flip the enable flag.
# MCPOLIS_SMTP_HOST=smtp.gmail.com
# MCPOLIS_SMTP_PORT=587
# MCPOLIS_SMTP_USERNAME=
# MCPOLIS_SMTP_PASSWORD=
# MCPOLIS_SMTP_FROM=info@mcphero.io
# MCPOLIS_SMTP_FROM_NAME=MCP Hero
# MCPOLIS_UPSTREAM_HEALTH_EMAIL_ENABLED=true
