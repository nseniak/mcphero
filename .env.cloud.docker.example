# MCP Hero — cloud-mode docker deployment env (template)
#
# Copy this file once per environment (dev / staging / prod) and
# fill in real values:
#
#   cp .env.cloud.docker.example .env.cloud.docker.prod
#
# All three environments share this template; per-environment
# values diverge in the populated copy. Populated copies are
# gitignored (see .gitignore — anything matching `.env*` except
# `*.example` / `*.test`).
#
# MCPOLIS_MODE and MCPOLIS_REDIS_URL are injected by the backend
# service's `environment:` block in docker-compose.yml and override
# anything set here — don't add them unless you're deploying outside
# the bundled compose stack.
#
# MCPOLIS_MONGO_URI is different: the backend's `environment:` block
# reads `${MCPOLIS_MONGO_URI:-mongodb://mongo:27017}`, so prod sets the
# credentialed app URI HERE and compose interpolates it (the cloud Mongo
# runs with --auth; see docker-compose.proxied.yml). Leave it unset for
# dev/native runs to fall back to the open default.
#MCPOLIS_MONGO_URI=mongodb://mcpolis_app:CHANGEME@mongo:27017/mcpolis?authSource=admin

# ---------------------------------------------------------------
# Core secrets
# ---------------------------------------------------------------
MCPOLIS_SESSION_SECRET=change-me-to-a-random-string
MCPOLIS_ENCRYPTION_KEY=change-me-to-a-random-string
MCPOLIS_MONGO_DB_NAME=mcpolis

# Public URL where the service is reachable (drives OAuth redirects).
MCPOLIS_SERVER_URL=http://localhost

# Public URL where the gateway MCP is exposed. Leave empty for
# single-origin deploys (gateway and dashboard share MCPOLIS_SERVER_URL).
# Set to a subdomain (e.g. https://mcp.mcphero.io) when running the
# gateway on its own host while the dashboard stays on apex.
MCPOLIS_GATEWAY_URL=

# ---------------------------------------------------------------
# Dashboard sign-in
# ---------------------------------------------------------------
# Cloud mode requires `google`; `dev_stub` is rejected at startup
# (it bypasses identity verification, dev/e2e only).
MCPOLIS_OAUTH_PROVIDER=google
MCPOLIS_GOOGLE_CLIENT_ID=
MCPOLIS_GOOGLE_CLIENT_SECRET=

# Comma-separated emails granted superadmin (cloud mode only).
MCPOLIS_SUPERADMIN_EMAILS=

# Inline JSON map of per-upstream OAuth client credentials, keyed
# by hostname. Avoids bind-mounting oauth_apps.json. Leave empty if
# no upstream needs OAuth. Example:
#   MCPOLIS_OAUTH_APPS_JSON={"githubcopilot.com":{"client_id":"...","client_secret":"..."}}
MCPOLIS_OAUTH_APPS_JSON=

# ---------------------------------------------------------------
# Observability — backend (runtime)
# ---------------------------------------------------------------
# Empty DSN/token disables each integration entirely.
MCPOLIS_SENTRY_DSN=
MCPOLIS_SENTRY_TRACES_SAMPLE_RATE=0.1
MCPOLIS_SENTRY_ENVIRONMENT=production
MCPOLIS_RELEASE=

MCPOLIS_MIXPANEL_TOKEN=
# `api-eu.mixpanel.com` for EU residency.
MCPOLIS_MIXPANEL_API_HOST=

# ---------------------------------------------------------------
# Observability — frontend (BUILD-TIME — rebuild required)
# ---------------------------------------------------------------
# Baked into the React bundle by docker/Dockerfile.nginx ARGs at
# `docker compose build`. Changing these requires
# `docker compose ... up -d --build`, not just a restart.
MCPOLIS_FRONTEND_SENTRY_DSN=
MCPOLIS_FRONTEND_SENTRY_TRACES_SAMPLE_RATE=0.1
MCPOLIS_FRONTEND_MIXPANEL_TOKEN=
MCPOLIS_FRONTEND_MIXPANEL_API_HOST=

# Public site URL (canonical, og:url/og:image, sitemap, robots).
# No trailing slash. Falls back to dev default if empty.
MCPOLIS_FRONTEND_SITE_URL=https://mcphero.io
# Gateway origin shown in the SignupPage URL preview. Leave empty for
# single-origin deploys (preview falls back to window.location.origin).
# Set to the subdomain (e.g. https://mcp.mcphero.io) so the URL the
# user sees during signup matches the one they'll paste into Claude.
MCPOLIS_FRONTEND_GATEWAY_URL=
# Marketing contact addresses surfaced on Privacy / Terms / Security / Support.
MCPOLIS_FRONTEND_CONTACT_EMAIL=hello@mcphero.io
MCPOLIS_FRONTEND_PRIVACY_EMAIL=privacy@mcphero.io
MCPOLIS_FRONTEND_SECURITY_EMAIL=security@mcphero.io
MCPOLIS_FRONTEND_SUPPORT_EMAIL=support@mcphero.io

# ---------------------------------------------------------------
# Stdio MCPs
# ---------------------------------------------------------------
# Cloud-mode default is OFF; flip true to register stdio MCPs.
MCPOLIS_ALLOW_STDIO_MCP=true

# ---------------------------------------------------------------
# Bundled demo MCP server
# ---------------------------------------------------------------
# Two independent toggles. Both default off in cloud mode.
#   - MCPOLIS_DEMO_MOUNT=1 mounts the kitchen-sink demo at
#     `/dev/mcp-demo` (no-auth HTTP target, in-process Python). Useful
#     as a target for an HTTP smoke test against a live deployment.
#   - MCPOLIS_DEMO_SEED=1 auto-registers the demo as a service-
#     account upstream on the first org. Lands the upstream on
#     whichever real customer org happens to be first — keep OFF
#     in prod.
# NB: empty value crashes pydantic bool parsing — use 0/1, not blank.
MCPOLIS_DEMO_MOUNT=0
MCPOLIS_DEMO_SEED=0

# ---------------------------------------------------------------
# Sandbox provider (SandboxService boundary)
# ---------------------------------------------------------------
# stdio MCPs run via the SandboxService boundary. Two backends:
#   - e2b              hosted SaaS (only valid choice in cloud)
#   - local-subprocess no isolation; rejected in cloud
# Empty falls back to `e2b` when MCPOLIS_E2B_API_KEY is set, else
# `local-subprocess` (with a startup warning). The legacy own-runner
# backend was removed; setting that value here is rejected at
# startup. See the "Sandbox provider selection" section in CLAUDE.md.
MCPOLIS_SANDBOX_PROVIDER=e2b

# E2B Pro team API key — required when SANDBOX_PROVIDER=e2b in
# cloud mode. Generate from https://e2b.dev under your E2B team.
MCPOLIS_E2B_API_KEY=

# Operator gate for E2B Volumes (the `persistent_disk_enabled`
# opt-in mounted at /data across sessions). Volumes are private
# beta as of 2026-05; the SDK 403s with "use of volumes is not
# enabled" until E2B turns it on for the team — email
# support@e2b.dev to enroll. Default false; flip true once
# enrolled.
MCPOLIS_E2B_VOLUMES_ENABLED=false

# E2B-side idle window before a sandbox auto-pauses (seconds).
# Lower = pay less for idle running time (paused sandboxes are
# free per E2B billing); higher = fewer cold-resume hops. The
# session layer reattaches the streaming RPC on the next tool
# call so a tighter window is safe. Default 60s; lower bound
# ~60s — below that, sandboxes risk pausing mid-operation.
MCPOLIS_E2B_IDLE_PAUSE_SECONDS=60

# ---------------------------------------------------------------
# Transactional email (SMTP)
# ---------------------------------------------------------------
# Powers the §5.2 upstream-health re-auth notifier. Empty
# MCPOLIS_SMTP_HOST falls back to a logging stub (no mail leaves the
# process). When MCPOLIS_UPSTREAM_HEALTH_EMAIL_ENABLED=true in cloud
# mode, the startup validator requires HOST / USERNAME / PASSWORD /
# FROM to be set.
#
# Google Workspace submission: host smtp.gmail.com, port 587
# (STARTTLS). Authenticate as a real Workspace user that has 2-Step
# Verification on and an App Password minted (Google Account →
# Security → App passwords). info@mcphero.io is a verified "Send mail
# as" alias on that user, so USERNAME (login) and FROM (visible
# sender) differ. Port 465 would select implicit TLS instead.
MCPOLIS_SMTP_HOST=smtp.gmail.com
MCPOLIS_SMTP_PORT=587
MCPOLIS_SMTP_USERNAME=
MCPOLIS_SMTP_PASSWORD=
MCPOLIS_SMTP_FROM=info@mcphero.io
MCPOLIS_SMTP_FROM_NAME=MCP Hero
# Master on/off for outbound notifications. Leave false until the
# SMTP creds above are filled and deliverability is proven.
MCPOLIS_UPSTREAM_HEALTH_EMAIL_ENABLED=false

# ---------------------------------------------------------------
# Log forwarding (Vector → Elastic Cloud Serverless)
# ---------------------------------------------------------------
# Consumed only by the `vector` sidecar in docker-compose.yml; the
# backend Settings ignores these (extra="ignore"). Both empty →
# Vector exits at startup with a clear error and the rest of the
# stack keeps running. Set them to forward logs to your Elastic Cloud
# instance (the endpoint URL + an ingest-scoped API key).
MCPOLIS_ELASTIC_ENDPOINT=
MCPOLIS_ELASTIC_API_KEY=
